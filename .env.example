# Порт приложения на хосте
APP_PORT=8080
APP_VERSION=local

# T-Invest API (readonly-токена достаточно)
TINKOFF_TOKEN=your_token_here
TINKOFF_MODE=prod
TINKOFF_SSL_VERIFY=true
# TINKOFF_SSL_CA_FILE=/path/in/container/to/corp-ca.pem
# TINKOFF_HTTPS_PROXY=http://proxy.example:8080

# Необязательные ключи для AI-чата
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# CHAT_MAX_OUTPUT_TOKENS=8192
